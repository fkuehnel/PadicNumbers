Cell[CellGroupData[{
Cell["", "GuideFunctionsSection", CellID->641035281],
Cell["Constructing p-adic numbers", "GuideFunctionsSubsection", CellID->1000],
Cell[TextData[{Cell[BoxData[ButtonBox["Padic", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/Padic"]], "InlineGuideFunction"], " \[LongDash] construct an exact, eventually periodic p-adic expansion"}], "GuideText", CellID->1001],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicN", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicN"]], "InlineGuideFunction"], " \[LongDash] retain a refinable source or construct a finite-precision approximation"}], "GuideText", CellID->1002],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicRational", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicRational"]], "InlineGuideFunction"], " \[LongDash] represent an exact rational p-adic expansion"}], "GuideText", CellID->1003],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicLazy", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicLazy"]], "InlineGuideFunction"], " \[LongDash] represent a refinable p-adic expression"}], "GuideText", CellID->1004],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicRationalN", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicRationalN"]], "InlineGuideFunction"], " \[LongDash] represent a finite-precision p-adic number"}], "GuideText", CellID->1005],
Cell["Inspecting and transforming numbers", "GuideFunctionsSubsection", CellID->1006],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicDigits", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicDigits"]], "InlineGuideFunction"], " \[LongDash] extract numeric digits from an expansion"}], "GuideText", CellID->1007],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicOrder", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicOrder"]], "InlineGuideFunction"], " \[LongDash] find the p-adic valuation"}], "GuideText", CellID->1008],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicAbs", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicAbs"]], "InlineGuideFunction"], " \[LongDash] find the p-adic absolute value"}], "GuideText", CellID->1009],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicNormalize", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicNormalize"]], "InlineGuideFunction"], " \[LongDash] remove the valuation"}], "GuideText", CellID->1010],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicCanonicalize", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicCanonicalize"]], "InlineGuideFunction"], " \[LongDash] put a representation in canonical form"}], "GuideText", CellID->1011],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicSignature", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicSignature"]], "InlineGuideFunction"], " \[LongDash] find the lengths of the stored and repeating digit blocks"}], "GuideText", CellID->1012],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicPeriodLength", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicPeriodLength"]], "InlineGuideFunction"], " \[LongDash] find the length of the repeating digit block"}], "GuideText", CellID->1013],
Cell["Visualization", "GuideFunctionsSubsection", CellID->1014],
Cell[TextData[{Cell[BoxData[ButtonBox["PadicDigitTree", BaseStyle->"Link", ButtonData->"paclet:FrankKuehnel/PadicNumbers/ref/PadicDigitTree"]], "InlineGuideFunction"], " \[LongDash] visualize p-adic digit paths in a tree"}], "GuideText", CellID->1015]
}, Open]],
