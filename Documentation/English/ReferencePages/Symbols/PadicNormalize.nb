   RowBox[{"PadicN", "[", 
    RowBox[{
     RowBox[{"75", "/", "7"}], ",", " ", "5", ",", " ", "4"}], "]"}], "]"}], 
  "]"}]], "Input",ExpressionUUID->"ff26f671-eb44-4f96-b18c-2f00554fd43a"],

