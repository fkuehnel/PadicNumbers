   RowBox[{"PadicNormalize", "[", 
    RowBox[{
     RowBox[{"75", "/", "7"}], ",", " ", "5"}], "]"}], ",", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"PadicNormalize", "[", 
     RowBox[{"Padic", "[", 
      RowBox[{
       RowBox[{"75", "/", "7"}], ",", " ", "5"}], "]"}], "]"}], "]"}]}], 
  "}"}]], "Input",ExpressionUUID->"a040c698-7856-49d5-89a5-d267237f442a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["3", "7"], ",", 
   FractionBox["3", "7"]}], "}"}]], "Output",ExpressionUUID->"30e7b5ff-f53d-\
4292-84f9-3a1aad9cd62c"]
}, Open  ]],

Cell[CellGroupData[{

