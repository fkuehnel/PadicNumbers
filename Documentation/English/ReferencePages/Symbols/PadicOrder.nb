   RowBox[{"PadicOrder", "[", 
    RowBox[{"Padic", "[", 
     RowBox[{
      RowBox[{"75", "/", "7"}], ",", " ", "5"}], "]"}], "]"}], ",", " ", 
   RowBox[{"PadicOrder", "[", 
    RowBox[{"0", ",", " ", "5"}], "]"}]}], "}"}]], "Input",ExpressionUUID->\
"a350c0b3-f519-4351-9230-65b2191f31f0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "2", ",", "\[Infinity]"}], "}"}]], "Output",ExpressionUUID\
->"8501b7f5-9a4a-4739-ae55-5bc1041e7b8d"]
}, Open  ]],

