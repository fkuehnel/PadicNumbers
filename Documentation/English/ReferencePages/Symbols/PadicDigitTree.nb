Notebook[{
Cell["PadicDigitTree", "ObjectName",ExpressionUUID->"b284b828-8ae1-4875-bc52-97b5c195f349"],

Cell["\<\
PadicDigitTree[p,depth] draws a p-branching digit tree for integer p>1 and \
positive depth. PadicDigitTree[p] chooses a depth automatically; explicit \
depth may be reduced to limit tree size. Prime p gives the p-adic \
interpretation. RayDigits highlights paths specified in lowest-place-first \
order. Object rays currently use normalized unit digits; finite snapshot rays \
use a reconstructed rational candidate, while lazy rays request the required \
digits directly. See README.md for options and limitations.\
\>", "Usage",ExpressionUUID->"3445cb0f-5615-4d1c-b5d4-908c7e35e4d0"],

Cell["\<\
Use integer branching base p>1 and positive depth. Prime bases give the \
p-adic interpretation. Automatic depth targets about 3000 edges; explicit \
depth is reduced toward 10000 edges when possible.\
\>", "Notes",ExpressionUUID->"9834ee34-8935-43de-9682-3e71ce43b17a"],

Cell["\<\
Custom options are public symbols. RayDigits takes lowest-place-first digit \
lists or p-adic objects. Layout accepts Hyperbolic, TopDown, or Tree. \
VertexLabelMode and EdgeLabelMode control labels; see README.md for every \
option and default.\
\>", "Notes",ExpressionUUID->"f2d1f24c-5003-4605-89fc-0bf39b058827"],

Cell["\<\
Current object rays show normalized unit digits without applying valuation. \
Finite snapshot rays use rational reconstruction and may extend beyond known \
digits; lazy rays request the needed digits directly; explicit digit lists \
can show only a known prefix.\
\>", "Notes",ExpressionUUID->"5d70aa9e-8d3a-4bab-a516-86ad302d51d4"],

Cell["\<\
Tree labels use decimal values and concatenated path labels can be ambiguous \
above base 10. The expansion formatter's letter/bar convention does not apply \
to tree labels.\
\>", "Notes",ExpressionUUID->"dc91bc8d-44ca-4920-93fb-634fff9dab49"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<PadicNumbers`\>\"", 
  "]"}]], "ExampleInitialization",ExpressionUUID->"d60ed5fd-9d44-4a9a-a874-\
de99772c264c"],

Cell["Basic Examples", "PrimaryExamplesSection",ExpressionUUID->"40268870-c34f-407b-ad9c-65da6cf77f2f"],

Cell[BoxData[
 RowBox[{"PadicDigitTree", "[", 
  RowBox[{"3", ",", " ", "2", ",", " ", 
   RowBox[{"RayDigits", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "0"}], "}"}]}], ",", " ", 
   RowBox[{"Layout", " ", "->", " ", "\"\<TopDown\>\""}]}], "]"}]], "Input",Ex\
pressionUUID->"3aed4e8c-7f53-4c73-bd66-c272287d0b99"],

Cell[BoxData[
 RowBox[{"PadicDigitTree", "[", 
  RowBox[{"5", ",", " ", "2", ",", " ", 
   RowBox[{"RayDigits", " ", "->", " ", 
    RowBox[{"Padic", "[", 
     RowBox[{
      RowBox[{"1", "/", "3"}], ",", " ", "5"}], "]"}]}], ",", " ", 
   RowBox[{"VertexLabelMode", " ", "->", " ", "\"\<FirstLayer\>\""}]}], 
  "]"}]], "Input",ExpressionUUID->"5e25a890-34ea-4cbc-8ad2-b54b539269ac"],

