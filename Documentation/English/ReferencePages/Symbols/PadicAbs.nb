   RowBox[{"PadicAbs", "[", 
    RowBox[{
     RowBox[{"75", "/", "7"}], ",", " ", "5"}], "]"}], ",", " ", 
   RowBox[{"PadicAbs", "[", 
    RowBox[{"Padic", "[", 
     RowBox[{
      RowBox[{"75", "/", "7"}], ",", " ", "5"}], "]"}], "]"}], ",", " ", 
   RowBox[{"PadicAbs", "[", 
    RowBox[{"0", ",", " ", "5"}], "]"}]}], "}"}]], "Input",ExpressionUUID->\
"f2426a6f-adf8-46ea-87d2-78db5342dca7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", "25"], ",", 
   FractionBox["1", "25"], ",", "0"}], "}"}]], "Output",ExpressionUUID->\
"a74ded2b-f54d-481e-926f-3425a84ef739"]
}, Open  ]],

