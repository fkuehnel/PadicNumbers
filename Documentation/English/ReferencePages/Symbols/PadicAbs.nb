    RowBox[{"1", ",", " ", "5", ",", " ", "1"}], "]"}], " ", "+", " ", 
   RowBox[{"PadicN", "[", 
    RowBox[{"4", ",", " ", "5", ",", " ", "1"}], "]"}]}], "]"}]], "Input",Expr\
essionUUID->"17273e4f-24b1-4464-bb5e-6ff7f9dce1ee"],

